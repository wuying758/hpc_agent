# HPC 集群 API 凭据（复制本文件为 .env 并填入真实值；.env 不要提交到版本库）
HPC_API_URL=https://your-hpc-api.example.com
HPC_DOMAIN=your-domain
HPC_OPERATOR=your.operator
HPC_PASSWORD=your-password

# 模型 API（OpenAI 兼容接口）
LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-model-name
